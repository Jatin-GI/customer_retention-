# Copy to .env and edit. Do not commit .env.
# SQLite is the default and needs no server. For PostgreSQL, install the server
# and use a URL such as:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/retail
DATABASE_URL=sqlite:///data/processed/retail.sqlite

# Directory that contains Online Retail.xlsx, or the file path itself.
RAW_DATA_PATH=data/raw

RANDOM_SEED=42
PREDICTION_HORIZON_DAYS=30
MIN_HISTORY_INVOICES=1
HISTORY_WARMUP_DAYS=90

# Optional single-file override (xlsx or csv).
# RAW_DATA_FILE=data/raw/Online Retail.xlsx
